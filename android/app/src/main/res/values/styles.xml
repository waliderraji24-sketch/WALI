<resources>
    <style name="Theme.Imi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Imi.CallScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/call_bg</item>
        <item name="android:windowBackground">@color/call_bg</item>
        <item name="android:statusBarColor">@color/call_bg</item>
        <item name="android:navigationBarColor">@color/call_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
