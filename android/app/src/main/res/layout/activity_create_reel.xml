<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="نشر مقطع Reel جديد"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Video Selection Container -->
        <FrameLayout
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tab_container">

            <LinearLayout
                android:id="@+id/layoutSelectPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#38BDF8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="اضغط لاختيار مقطع فيديو"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedVideoNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="تم اختيار مقطع الفيديو بنجاح ✓"
                android:textColor="#22C55E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Caption Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="right"
            android:text="وصف المقطع"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#1E293B"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#38BDF8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReelCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اكتب وصفاً أو وسوماً للمقطع..."
                android:inputType="textMultiLine"
                android:lines="3"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Publish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishReel"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#0284C7"
            android:text="نشر المقطع الآن"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/pbPublishLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
