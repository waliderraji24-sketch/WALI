<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- Remote Fullscreen SurfaceView -->
    <FrameLayout
        android:id="@+id/remoteVideoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Caller Information (Audio call or initial connection) -->
    <LinearLayout
        android:id="@+id/layoutCallHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivCallPeerAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/tvCallPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:text="مستخدم IMI"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:text="00:15"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Local Camera Preview PiP -->
    <FrameLayout
        android:id="@+id/localVideoContainer"
        android:layout_width="110dp"
        android:layout_height="160dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        android:background="#1E293B"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/layoutCallControls"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mic Toggle Button -->
        <ImageView
            android:id="@+id/btnToggleMic"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Mute Mic"
            android:padding="12dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="#FFFFFF" />

        <!-- Camera Switch Button -->
        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Switch Camera"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#FFFFFF" />

        <!-- End Call Button -->
        <ImageView
            android:id="@+id/btnEndCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_circle_badge"
            android:backgroundTint="#EF4444"
            android:contentDescription="End Call"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
